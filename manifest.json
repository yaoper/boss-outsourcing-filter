{
  "manifest_version": 3,
  "name": "Outsource Company Highlighter",
  "version": "1.1",
  "description": "Highlight outsource companies in job listings.",
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.zhipin.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["companies.txt"],
      "matches": ["*://*.zhipin.com/*"]
    }
  ]
}
